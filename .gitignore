# Ignore Python cache
__pycache__/
*.py[cod]
*.pyo

# Runtime logs
*.log
*.out
*.err
logs/*
*/logs/*
!logs/.gitkeep
!*/logs/.gitkeep
run_artifacts/

# Ignore environment files
.env
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Ignore Streamlit secrets
.streamlit/secrets.toml

# Ignore IDE/project files
.idea/
.vscode/

# Secrets
secrets/*
!secrets/*.example.toml
