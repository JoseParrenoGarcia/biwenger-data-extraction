<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.biwenger.players</string>

  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/biwenger-data-extraction/bash_scripts/run_players.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/biwenger.players.launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/biwenger.players.launchd.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>BIWENGER_UPLOAD_BATCH_SIZE</key>
    <string>10</string>
    <key>BIWENGER_RETRY_TOP_PLAYERS</key>
    <string>400</string>
  </dict>

  <!-- Optional safe manual-test limits:
  <key>EnvironmentVariables</key>
  <dict>
    <key>BIWENGER_UPLOAD_BATCH_SIZE</key>
    <string>10</string>
    <key>BIWENGER_RETRY_TOP_PLAYERS</key>
    <string>400</string>
    <key>BIWENGER_MAX_PLAYER_PAGES</key>
    <string>1</string>
    <key>BIWENGER_MAX_PLAYERS</key>
    <string>2</string>
  </dict>
  -->
</dict>
</plist>
